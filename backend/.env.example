# Copy to .env and fill in real values. Never commit the real .env file.

# Required for live LLM screening. Without it the server still boots but
# /screen returns a clear "not configured" error instead of a fake verdict.
GROQ_API_KEY=

# Postgres connection string (Neon or any Postgres). Leave empty to fall back
# to a local SQLite file (conduct_guardian.db) — fine for local dev/tests.
DATABASE_URL=

# Comma-separated list of origins allowed to call the API.
FRONTEND_ORIGIN=http://127.0.0.1:3000,http://localhost:3000

# Required by the seed script to authenticate its calls to /screen.
SEED_TOKEN=

GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_BULK=openai/gpt-oss-120b

# Optional — enables the real IMAP email channel. Leave both empty to
# disable it; the poller just doesn't start.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_POLL_INTERVAL_SECONDS=15
